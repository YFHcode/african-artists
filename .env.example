# Copy to .env.local for local development; set the same names in
# Vercel → Project → Settings → Environment Variables for production.

# Canonical origin. Must match the primary domain configured in Vercel.
NEXT_PUBLIC_SITE_URL=https://africanartists.com

# Offer form delivery (https://resend.com — free tier is plenty).
# Without these the form explains that offers are temporarily unavailable
# and points to the marketplace listing, if one is configured.
RESEND_API_KEY=
# Where offers are delivered. Not shown anywhere on the site.
OFFER_TO_EMAIL=
# Sender. resend.dev's test sender can only deliver to the Resend account's
# own address, which is exactly this use; verify africanartists.com in Resend
# to send from your own domain instead.
OFFER_FROM_EMAIL=AfricanArtists.com <onboarding@resend.dev>

# Optional marketplace listing. Both must be set for the button to appear.
NEXT_PUBLIC_MARKETPLACE_URL=
NEXT_PUBLIC_MARKETPLACE_NAME=
