# Copy to .env.local for local development; set the same names in
# Vercel → Project → Settings → Environment Variables for production.

# Canonical origin. Must match the primary domain configured in Vercel.
NEXT_PUBLIC_SITE_URL=https://africanartists.com

# Contact form delivery (https://resend.com — free tier is plenty).
# Without these the form explains that messages cannot be sent at the moment.
RESEND_API_KEY=
# Where messages are delivered. Not shown anywhere on the site.
# (OFFER_TO_EMAIL, the name used before November 2026, still works.)
CONTACT_TO_EMAIL=
# Sender. resend.dev's test sender can only deliver to the Resend account's
# own address, which is exactly this use; verify africanartists.com in Resend
# to send from your own domain instead. (OFFER_FROM_EMAIL still works.)
CONTACT_FROM_EMAIL=AfricanArtists.com <onboarding@resend.dev>
